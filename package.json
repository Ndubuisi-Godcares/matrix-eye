{
  "name": "eagles-eye",
  "version": "0.1.0",
  "private": true,
  "description": "Eagle's Eye — a website intelligence engine that turns a website into a source-grounded conversational assistant.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npm run run --workspace @eagles-eye/evals",
    "dev:api": "npm run dev --workspace @eagles-eye/api",
    "eagle": "tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
