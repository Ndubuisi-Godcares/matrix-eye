---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="The page you were looking for does not exist or has moved. Use these links to get back to the home page or the documentation." noindex>
  <section class="section">
    <div class="container prose">
      <span class="eyebrow">404</span>
      <h1>We can't find that page</h1>
      <p class="lead">It may have moved, or the address may have a typo.</p>
      <p><a class="btn btn--primary" href="/">Go to the home page</a> <a class="btn btn--secondary" href="/docs/">Browse the docs</a></p>
    </div>
  </section>
</Base>
