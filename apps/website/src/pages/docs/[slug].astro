---
import { getCollection, render } from "astro:content";
import { DOC_PAGES } from "../../data/docs";
import Docs from "../../layouts/Docs.astro";

/** One page per entry in the documentation manifest (data/docs.ts). */
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return DOC_PAGES.map((page) => {
    const entry = entries.find((e) => e.id === page.slug);
    if (!entry) throw new Error(`Documentation file docs/${page.slug}.md is listed in src/data/docs.ts but does not exist.`);
    return { params: { slug: page.slug }, props: { entry } };
  });
}

const { slug } = Astro.params;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs slug={slug!} {headings}>
  <Content />
</Docs>
