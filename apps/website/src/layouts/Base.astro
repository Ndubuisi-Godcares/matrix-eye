---
/**
 * The page shell shared by every page: head (title, description, canonical, social previews, icons, fonts,
 * structured data), skip link, header, main landmark and footer.
 */
import "../styles/global.css";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import frauncesFont from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE, absoluteUrl } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search results (draft legal pages). */
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Extra structured data (JSON-LD) objects for this page. */
  jsonLd?: object[];
  /** ISO date for articles. */
  published?: string;
}

const { title, description, noindex = false, ogType = "website", jsonLd = [], published } = Astro.props;
const isHome = Astro.url.pathname === "/";
const fullTitle = isHome ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl("/og.png");

/** Facts about the organisation and the site, repeated on every page for search engines. */
const baseJsonLd = [
  { "@context": "https://schema.org", "@type": "Organization", name: SITE.name, url: SITE.url, logo: absoluteUrl("/icon-512.png") },
  { "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: SITE.url },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1320" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Matrix Eye logo: a navy and gold eagle eye made of pixel squares, with the word MatrixEye" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} guides`} href="/rss.xml" />

    <!-- The two fonts every page uses are fetched early; the code font loads only on pages that show code. -->
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesFont} as="font" type="font/woff2" crossorigin />

    <!-- Sets the colour theme before the page paints (no flash) and marks that JavaScript is available. Tiny, external, so a strict CSP can allow it. -->
    <script is:inline src="/theme-init.js"></script>

    {[...baseJsonLd, ...jsonLd].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
