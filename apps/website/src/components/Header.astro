---
import { NAV } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
/** A nav link is "current" for its own page and everything beneath it (e.g. /docs/ for /docs/widget/). */
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="MatrixEye, home"><Logo height={30} /></a>

    <button class="icon-btn nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" />
    </button>

    <nav aria-label="Main">
      <ul class="nav__links" id="site-nav" data-nav>
        {NAV.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="icon-btn" type="button" data-cmdk-open hidden aria-label="Search this website (Ctrl K)">
        <Icon name="search" />
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
        <Icon name="moon" class="theme-moon" />
        <Icon name="sun" class="theme-sun" />
      </button>
      <a class="btn btn--primary btn--sm" href="/waitlist/">Join the waitlist</a>
    </div>
  </div>
</header>
