---
/**
 * The brand lockup: the eye mark as an image plus the name as live text, "MATRIX" in the page's ink colour and "EYE"
 * in gold (the same two colours as the full logo). The lettering is text, not part of the picture, so it stays sharp
 * at any size and is readable by assistive technology (it is the link's accessible name, "MATRIXEYE"). The mark comes in a light and a dark version; CSS shows the
 * right one (see global.css). Width and height are set so the page does not shift while the image loads.
 */
interface Props {
  height?: number;
}
const { height = 42 } = Astro.props;
const width = Math.round(height * (1206 / 564)); // the mark's aspect ratio
---

<span class="lockup">
  <img class="logo-light" src="/brand/mark-light.webp" alt="" width={width} height={height} decoding="async" fetchpriority="high" />
  <img class="logo-dark" src="/brand/mark-dark.webp" alt="" aria-hidden="true" width={width} height={height} decoding="async" />
  <span class="lockup__name" style={`font-size: ${Math.round(height * 0.5)}px`}><span class="lockup__a">MATRIX</span><span class="lockup__b">EYE</span></span>
</span>
