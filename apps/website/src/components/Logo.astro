---
/**
 * The logo as two images, one for light and one for dark backgrounds; CSS shows the right one (see global.css).
 * Width and height are set so the page does not shift while the image loads.
 */
import { SITE } from "../data/site";
interface Props {
  height?: number;
}
const { height = 42 } = Astro.props;
const width = Math.round(height * (720 / 400)); // the logo's aspect ratio
---

<img class="logo-light" src="/brand/logo-light.webp" alt={SITE.name} width={width} height={height} decoding="async" fetchpriority="high" />
<img class="logo-dark" src="/brand/logo-dark.webp" alt="" aria-hidden="true" width={width} height={height} decoding="async" />
