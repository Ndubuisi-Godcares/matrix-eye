# Copy to .env for local development. Never commit real values.

# --- API server -------------------------------------------------------------
# Bearer token required on every /v1 request.
EAGLE_API_KEY=change-me-to-a-long-random-string
PORT=8787
# SQLite file holding knowledge, projects and crawl jobs.
EAGLE_DB_PATH=./data/eagle.sqlite
# Comma-separated browser origins allowed to call the API (widget host sites).
EAGLE_CORS_ORIGINS=http://localhost:3000

# --- Language model (optional) ----------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, or a hosted provider.
# Leave EAGLE_LLM_BASE_URL unset to run in extractive mode (no model needed).
# Ollama example:  http://localhost:11434/v1   with model e.g. qwen2.5:7b-instruct
EAGLE_LLM_BASE_URL=
EAGLE_LLM_MODEL=
EAGLE_LLM_API_KEY=

# --- Crawler ----------------------------------------------------------------
# Only set to "true" on a trusted dev machine to crawl localhost / private IPs.
EAGLE_ALLOW_PRIVATE_NETWORKS=false
