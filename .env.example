# Copy to .env for local development. Never commit real values.

# --- API server -------------------------------------------------------------
# Bearer token required on every /v1 request.
MATRIX_EYE_API_KEY=change-me-to-a-long-random-string
PORT=8787
# SQLite file holding knowledge, projects and crawl jobs.
MATRIX_EYE_DB_PATH=./data/matrix-eye.sqlite
# Comma-separated browser origins allowed to call the API (widget host sites).
MATRIX_EYE_CORS_ORIGINS=http://localhost:3000

# Chat messages per minute per visitor and project on the public (widget) endpoints.
MATRIX_EYE_PUBLIC_RATE_LIMIT_PER_MINUTE=20

# --- Language model (optional) ----------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, or a hosted provider.
# Leave MATRIX_EYE_LLM_BASE_URL unset to run in extractive mode (no model needed).
# Ollama example:  http://localhost:11434/v1   with model qwen3:4b-instruct
# Use a NON-thinking model: reasoning models are slow and can leak their thinking into answers.
MATRIX_EYE_LLM_BASE_URL=
MATRIX_EYE_LLM_MODEL=
MATRIX_EYE_LLM_API_KEY=

# --- Crawler ----------------------------------------------------------------
# Only set to "true" on a trusted dev machine to crawl localhost / private IPs.
MATRIX_EYE_ALLOW_PRIVATE_NETWORKS=false
